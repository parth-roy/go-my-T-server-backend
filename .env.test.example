# TIME-010 Enterprise Certification - Dedicated PostgreSQL Test Database
# 
# IMPORTANT: Do NOT use development or production databases.
# This database must be strictly isolated for E2E integration tests.
# The E2E tests will create, modify, and delete real records.

# The connection string to the dedicated PostgreSQL test database
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/time010_test_db?schema=public"

# If using a connection pooler (e.g. PgBouncer), specify the direct connection for migrations
DIRECT_URL_TEST="postgresql://user:password@localhost:5432/time010_test_db?schema=public"
